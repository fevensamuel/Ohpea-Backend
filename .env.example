# Server configuration
PORT=3000
NODE_ENV=development

# Database (PostgreSQL)
# If PostgreSQL is not running locally, the system falls back to the built-in in-memory PostgreSQL engine for development/demo.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ohpea
DATABASE_SSL=false

# Authentication & Security
# Must be at least 32 characters long
JWT_SECRET=ohpea_super_secure_jwt_secret_key_2026_min_32_characters_long
JWT_EXPIRES_IN=8h
SERVER_PEPPER=ohpea_internal_pepper_duplicate_detection_2026_salt
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# File Uploads
UPLOAD_PATH=./uploads
PRIVATE_UPLOAD_PATH=./private_uploads

# Initial SuperAdmin Seed (password change forced on first login)
SEED_ADMIN_EMAIL=admin@ohpea.org
SEED_ADMIN_PASSWORD=Admin12345!ChangeMe

# Email / SMTP (nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=no-reply@ohpea.org
SMTP_PASS=
SMTP_FROM="OHPEA <no-reply@ohpea.org>"

# SMS (AfroMessage)
AFROMESSAGE_TOKEN=
AFROMESSAGE_IDENTIFIER_ID=
AFROMESSAGE_SENDER_NAME=OHPEA

# OTP Settings
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5

# Feature Flags (Phases 1-4)
FEATURE_EMAIL_OTP=false
FEATURE_SMS=false
FEATURE_MEMBER_PORTAL=false
SEED_DEMO_DATA=true
